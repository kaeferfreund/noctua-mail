{
  "name": "noctua-mail",
  "version": "0.1.0",
  "license": "Elastic-2.0",
  "author": "Paul Wellner Bou <paul@wellnerbou.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulwellnerbou/noctua-mail.git"
  },
  "homepage": "https://github.com/paulwellnerbou/noctua-mail#readme",
  "bugs": {
    "url": "https://github.com/paulwellnerbou/noctua-mail/issues"
  },
  "packageManager": "bun@1.4.4",
  "type": "module",
  "scripts": {
    "dev": "ENV_FILE=${ENV_FILE:-.env.local} bun --bun build-scripts/generateRuntimeConfig.ts && bun --env-file=${ENV_FILE:-.env.local} --bun next dev",
    "build": "bun --bun build-scripts/generateBuildVersion.ts && bun --bun next build",
    "start": "ENV_FILE=${ENV_FILE:-.env.local} bun --bun build-scripts/generateRuntimeConfig.ts && bun --env-file=${ENV_FILE:-.env.local} --bun next start",
    "lint": "eslint .",
    "test": "bun test --timeout 20000 && bun run test:dom",
    "test:ci": "bun test --timeout 20000 && bun run test:dom",
    "test:dom": "bun test --config=bunfig.dom.toml dom.test",
    "test:stress": "bun test --timeout 20000 --randomize --seed=1337 --rerun-each=3",
    "test:standalone-workers": "bun run build && bun --bun build-scripts/verifyStandaloneWorkerBuild.ts",
    "test:docker-workers": "bun --bun build-scripts/verifyDockerWorkerImage.ts",
    "desktop:dev-server": "PORT=3655 APP_ENV_LABEL=Desktop NOCTUA_DESKTOP_MODE=true IMAP_CREDENTIALS_STORAGE=db NOCTUA_DATA_DIR=../noctua-data-desktop bun run dev",
    "desktop:dev": "bunx tauri dev",
    "desktop:build": "bash build-scripts/build-desktop.sh",
    "dev:fixture": "bun --env-file=.env.local scripts/dev-fixture/run.ts"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/rrule": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@lexical/code-core": "^0.43.0",
    "@lexical/history": "^0.43.0",
    "@lexical/html": "^0.43.0",
    "@lexical/link": "^0.43.0",
    "@lexical/list": "^0.43.0",
    "@lexical/markdown": "^0.43.0",
    "@lexical/react": "^0.43.0",
    "@lexical/rich-text": "^0.43.0",
    "@lexical/table": "^0.43.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@uiw/react-md-editor": "^4.1.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "entities": "^7.0.1",
    "html-to-text": "^9.0.5",
    "imapflow": "^1.7.8",
    "lexical": "^0.43.0",
    "lucide-react": "^1.61.0",
    "mailparser": "^3.12.3",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.11",
    "parse5": "^7.3.0",
    "postcss": "^8.5.31",
    "radix-ui": "1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-file-icon": "^1.6.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.8",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rrule": "^2.8.1",
    "sanitize-html": "^2.18.1",
    "tailwindcss": "^4.3.3",
    "tsdav": "^2.5.0",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.6",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "shadcn": "^4.22.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "typescript-eslint": "^8.59.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@typescript-eslint/scope-manager": "^8.59.0",
    "@typescript-eslint/type-utils": "^8.59.0",
    "@typescript-eslint/types": "^8.59.0",
    "@typescript-eslint/typescript-estree": "^8.59.0",
    "@typescript-eslint/utils": "^8.59.0",
    "@typescript-eslint/visitor-keys": "^8.59.0",
    "@typescript-eslint/project-service": "^8.59.0",
    "@typescript-eslint/tsconfig-utils": "^8.59.0"
  }
