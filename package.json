{
  "name": "noctua-mail",
  "version": "1.0.11",
  "license": "Elastic-2.0",
  "author": "Paul Wellner Bou <paul@wellnerbou.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulwellnerbou/noctua-mail.git"
  },
  "homepage": "https://github.com/paulwellnerbou/noctua-mail#readme",
  "bugs": {
    "url": "https://github.com/paulwellnerbou/noctua-mail/issues"
  },
  "packageManager": "bun@1.4.4",
  "type": "module",
  "scripts": {
    "dev": "ENV_FILE=${ENV_FILE:-.env.local} bun --bun build-scripts/generateRuntimeConfig.ts && bun --env-file=${ENV_FILE:-.env.local} --bun next dev",
    "build": "bun --bun build-scripts/generateBuildVersion.ts && bun --bun next build && bun check && bun build-scripts/prepareStandaloneShutdown.ts",
    "start": "ENV_FILE=${ENV_FILE:-.env.local} bun --bun build-scripts/generateRuntimeConfig.ts && bun --env-file=${ENV_FILE:-.env.local} --bun next start",
    "lint": "eslint .",
    "typecheck": "bun check",
    "test": "bun test --timeout 20000 && bun run test:dom",
    "test:ci": "bun test --timeout 20000 && bun run test:dom",
    "test:dom": "bun test --config=bunfig.dom.toml dom.test",
    "test:stress": "bun test --timeout 20000 --randomize --seed=1337 --rerun-each=3",
    "test:parallel-probe": "bun test --timeout 20000 --parallel=4",
    "test:stress-parallel": "bun test --timeout 20000 --parallel=4 --randomize --rerun-each=3",
    "test:standalone-workers": "bun run build && bun --bun build-scripts/verifyStandaloneWorkerBuild.ts",
    "test:docker-workers": "bun --bun build-scripts/verifyDockerWorkerImage.ts",
    "test:auth-browser": "bun scripts/runAuthBrowserTests.ts",
    "dev:fixture": "bun --env-file=.env.local scripts/dev-fixture/run.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.97",
    "@better-auth/passkey": "1.7.18",
    "@fullcalendar/react": "^7.1.4",
    "@fullcalendar/rrule": "^7.1.4",
    "@lexical/code-core": "^0.53.0",
    "@lexical/history": "^0.53.0",
    "@lexical/html": "^0.53.0",
    "@lexical/link": "^0.53.0",
    "@lexical/list": "^0.53.0",
    "@lexical/markdown": "^0.53.0",
    "@lexical/react": "^0.53.0",
    "@lexical/rich-text": "^0.53.0",
    "@lexical/table": "^0.53.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@uiw/react-md-editor": "^4.2.3",
    "ai": "7.0.163",
