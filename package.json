    "lexical": "^0.53.0",
    "lucide-react": "^1.70.0",
    "mailparser": "^3.14.2",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "nodemailer": "^10.3.1",
    "parse5": "^8.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rrule": "^2.8.1",
    "sanitize-html": "^2.18.1",
    "tsdav": "^2.5.0",
    "turndown": "^7.2.5",
    "unified": "^11.0.5",
    "zod": "^4.6.7",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.32",
    "radix-ui": "1.8.1",
    "react-resizable-panels": "^4.18.1",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "qrcode": "^1.5.4",
    "temporal-polyfill": "^1.0.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
