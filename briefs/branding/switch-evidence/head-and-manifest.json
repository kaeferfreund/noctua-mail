{
  "documentTitle": "Mail (Dev)",
  "headIcons": [
    "manifest /manifest.webmanifest",
    "icon /icons/badged/256?v=2",
    "apple-touch-icon /icons/apple-touch?v=2"
  ],
  "manifest": {
    "id": "/",
    "name": "Mail (Dev)",
    "short_name": "Mail (Dev)",
    "description": "Webmail für persönliche und gemeinsame Postfächer",
    "start_url": "/",
    "display": "standalone",
    "background_color": "#f3f1ec",
    "theme_color": "#5b5bd6",
    "icons": [
      {
        "src": "/icons/badged/192?v=2",
        "sizes": "192x192",
        "type": "image/png"
      },
      {
        "src": "/icons/badged/512?v=2",
        "sizes": "512x512",
        "type": "image/png"
      },
      {
        "src": "/icons/badged/32?v=2",
        "sizes": "32x32",
        "type": "image/png"
      }
    ],
    "file_handlers": [
      {
        "action": "/calendar/import",
        "accept": {
          "text/calendar": [
            ".ics"
          ]
        }
      }
    ],
    "protocol_handlers": [
      {
        "protocol": "mailto",
        "url": "/?c=%s"
      }
    ]
  }
}
