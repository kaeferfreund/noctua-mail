===== preserved runner source =====
from pathlib import Path
import subprocess,os
root=Path.cwd(); scratch=root/'.tmp'; briefs=root.parent/'briefs'
env={**os.environ,'TMPDIR':str(scratch)}
with (scratch/'preserved.log').open('w') as log:
 for round in range(2,8):
  for src in sorted((briefs/f'collab-ui-fix-r{round}-repros').glob('*test.ts*')):
   dest=scratch/f'r{round}'/src.name;dest.parent.mkdir(exist_ok=True)
   text=src.read_text()
   if src.name=='revision-r6.test.ts':
    # A subprocess runner in this file lives in a system temp directory, so its
    # ../lib import no longer resolves after moving the fixture to .tmp/r6.
    text=text.replace('new URL("../lib/db/schema.ts", import.meta.url)', 'new URL("../../lib/db/schema.ts", import.meta.url)')
   dest.write_text(text)
   cmd=['bun','test','--timeout','20000']
   if '.dom.test.' in src.name:cmd+=['--config=bunfig.dom.toml']
   cmd+=['./'+str(dest.relative_to(root))]
   log.write('COMMAND: '+' '.join(cmd)+'\nSOURCE: '+str(src)+'\n');log.flush()
   r=subprocess.run(cmd,cwd=root,env=env,stdout=log,stderr=subprocess.STDOUT)
   log.write('EXIT: '+str(r.returncode)+'\n\n');log.flush()
   print('r'+str(round),src.name,'exit',r.returncode,flush=True)


