 /** Calendar-day ordinal in the explicit display zone; subtraction stays correct across DST. */
+const displayDayMemo = new Map<string, number>();
 export function displayDayNumber(value: Date | number, zone = timeZone) {
+  const ms = typeof value === "number" ? value : value.getTime();
+  if (Number.isFinite(ms)) {
+    const k = zone + ":" + Math.floor(ms / 60_000);
+    const hit = displayDayMemo.get(k);
+    if (hit !== undefined) return hit;
+    const computed = displayDayNumberUncached(ms, zone);
+    if (displayDayMemo.size > 50_000) displayDayMemo.clear();
+    displayDayMemo.set(k, computed);
+    return computed;
+  }
+  return displayDayNumberUncached(value, zone);
+}
+function displayDayNumberUncached(value: Date | number, zone: string) {
   const parts = cached(dates, `display-day:${zone}`, () => new Intl.DateTimeFormat("en-CA", {
     year: "numeric", month: "2-digit", day: "2-digit", timeZone: zone
   })).formatToParts(value);
