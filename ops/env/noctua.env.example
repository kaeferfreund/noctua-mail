# Purpose: slice-6 runtime environment template; runbook §2.2; REVIEW BEFORE USE.
# Copy privately to /srv/noctua/env/noctua.env, root:root 0600; parent root:root 0700. Never commit it.
# Production runtime; required by Next.
NODE_ENV=production
# IPv4 loopback only; the system unit also enforces this.
HOSTNAME=127.0.0.1
# Backend port from runbook §0/§2.2; coordinate proxy and healthchecks if changed.
PORT=3654
# Absolute production data root; never point at development/fixture storage.
NOCTUA_DATA_DIR=/srv/noctua/data
# Disable Next build/runtime telemetry.
NEXT_TELEMETRY_DISABLED=1
# Sole canonical origin; 8443 alternative requires an explicit origin decision, see caddy/README.md.
BETTER_AUTH_URL=https://mails.monkeymed.de
# Passkey relying-party hostname, without scheme or port; must match the URL host exactly.
# For synthetic http://127.0.0.1:<port>, use 127.0.0.1 here, not localhost.
PASSKEY_RP_ID=mails.monkeymed.de
# Independent random secret >=32 characters; REPLACE this placeholder privately (also encrypts MFA).
BETTER_AUTH_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_AUTH_SECRET_32_CHARS_MINIMUM
# Independent encryption key: replace with 64 hex characters, or retain the matching existing key.
IMAP_SECRET_KEY=REPLACE_WITH_INDEPENDENT_64_HEX_OR_PRESERVED_EXISTING_KEY
# Encrypted server-side credential storage; cookie mode fails slice-6 startup.
IMAP_CREDENTIALS_STORAGE=db
# Disable Better Auth telemetry; no telemetry endpoint override.
BETTER_AUTH_TELEMETRY=0
# Exactly one sanitized reverse proxy hop; Better Auth also reads proxy-sanitized XFF.
TRUSTED_PROXY_HOPS=1
# Watcher default is unset/off; explicit 0 until all import/count gates pass, then review 1.
NOCTUA_MAILBOX_WATCHER=0
# Code default 2; runbook initial-load recommendation is the conservative override 1.
NOCTUA_MAX_SYNC_WORKERS=1
# Watcher fallback interval, default 300000 ms.
NOCTUA_WATCHER_INTERVAL_MS=300000
# Account inventory poll interval, default 30000 ms.
NOCTUA_WATCHER_ACCOUNTS_INTERVAL_MS=30000
# Minimum reconnect delay, default 60000 ms; exponential backoff reaches 30 min.
NOCTUA_WATCHER_RECONNECT_MIN_MS=60000
# Sync subprocess execution deadline, default 600000 ms.
NOCTUA_SYNC_WORKER_TIMEOUT_MS=600000
# Explicitly UNSET (remove inherited definitions too, do not assign empty strings):
# NOCTUA_TRUSTED_ORIGINS, NOCTUA_IMAP_LOGIN_HOSTS, NOCTUA_DESKTOP_MODE,
# BETTER_AUTH_TELEMETRY_ENDPOINT, SESSION_SEAL_KEY.
